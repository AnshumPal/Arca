OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o-mini
# Optional: set a custom base URL to use Groq, Together AI, etc. Leave blank for OpenAI.
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
DATABASE_URL=postgresql+asyncpg://arca:arca@db:5432/arca
POSTGRES_USER=arca
POSTGRES_PASSWORD=arca
POSTGRES_DB=arca
APP_ENV=development

# Phase 8 — LLM-based semantic router.
# false = fast keyword classifier (~70% accuracy, zero LLM cost)
# true  = LLM classifier (~95% accuracy, +300-800ms latency, extra LLM call per chat)
USE_SEMANTIC_ROUTER=false

# Phase 9 — LLM-as-judge quality dimension.
# false = 4-dimension evaluator only (latency, length, feedback, error)
# true  = adds a 5th 'judgment' score per trace via one extra LLM call after each chat
USE_LLM_JUDGE=false
